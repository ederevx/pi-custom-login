    "url": "git+https://github.com/ederevx/pi-custom-login.git"
  },
  "bugs": {
    "url": "https://github.com/ederevx/pi-custom-login/issues"
  },
  "keywords": [
    "pi-package",
    "pi",
    "provider",
    "models",
    "login"
  ],
